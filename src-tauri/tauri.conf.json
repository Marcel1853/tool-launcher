{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tool Launcher",
  "version": "2.0.0",
  "identifier": "de.marcel.toollauncher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tool Launcher",
        "width": 1040,
        "height": 680,
        "minWidth": 640,
        "minHeight": 420,
        "backgroundColor": "#151a23"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Startet und aktualisiert eigene Programme"
  }
}
